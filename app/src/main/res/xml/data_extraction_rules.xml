<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Back up Room database and user settings; exclude only transient active focus timer state. -->
        <exclude domain="file" path="datastore/tag_focus_runtime.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/tag_focus_runtime.preferences_pb" />
    </device-transfer>
</data-extraction-rules>

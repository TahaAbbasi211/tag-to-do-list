<?xml version="1.0" encoding="utf-8"?>
<!--
    Wide widget (4x2): the progress block on the left, up to three open items on the right.
    The items column is hidden by the renderer when there is nothing to list, so the
    progress block simply takes the full width instead of leaving an empty column.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <!-- Progress block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="37"
        android:background="@drawable/widget_hero_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_status_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_check_circle"
                android:tint="@color/widget_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/widget_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Next items -->
    <LinearLayout
        android:id="@+id/widget_items"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="63"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_item_icon_1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_bolt"
                android:tint="@color/widget_icon_tint" />

            <TextView
                android:id="@+id/widget_item_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_item_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/widget_item_check_1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_check_btn_bg"
                android:clickable="true"
                android:contentDescription="@string/widget_mark_done_action"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_mark_done"
                android:tint="@color/widget_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_item_icon_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_bolt"
                android:tint="@color/widget_icon_tint" />

            <TextView
                android:id="@+id/widget_item_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_item_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/widget_item_check_2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_check_btn_bg"
                android:clickable="true"
                android:contentDescription="@string/widget_mark_done_action"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_mark_done"
                android:tint="@color/widget_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_item_icon_3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_bolt"
                android:tint="@color/widget_icon_tint" />

            <TextView
                android:id="@+id/widget_item_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_item_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/widget_item_check_3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_check_btn_bg"
                android:clickable="true"
                android:contentDescription="@string/widget_mark_done_action"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_mark_done"
                android:tint="@color/widget_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

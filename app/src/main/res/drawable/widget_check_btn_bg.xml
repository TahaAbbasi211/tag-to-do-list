<?xml version="1.0" encoding="utf-8"?>
<!-- Circular touch target with a soft accent badge and press ripple (no ?attr/ for RemoteViews). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_check_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="@color/widget_accent_soft" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_accent_soft" />
        </shape>
    </item>
</ripple>
